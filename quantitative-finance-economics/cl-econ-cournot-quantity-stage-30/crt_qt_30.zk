// cl-econ-cournot-quantity-stage-30: Cournot Duopoly Best-Response Output Stage 30
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cournot_best_response_30(demand_intercept: float, marginal_cost: float, q_competitor: float) -> float:
    return 0.5 * (demand_intercept - marginal_cost - q_competitor) * 30.0
