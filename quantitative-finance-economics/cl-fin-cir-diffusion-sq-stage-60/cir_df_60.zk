// cl-fin-cir-diffusion-sq-stage-60: CIR Short Rate Diffusion Squared Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_60(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 60.0
