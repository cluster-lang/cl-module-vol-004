// cl-econ-vickrey-payoff-stage-25: Test Suite
import "../vck_po_25.zk"

fn test_run():
    res := vickrey_surplus_25(100.0, 70.0)
    diff := res - 750.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-vickrey-payoff-stage-25!")
