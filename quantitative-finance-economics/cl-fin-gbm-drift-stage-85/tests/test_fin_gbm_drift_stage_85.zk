// cl-fin-gbm-drift-stage-85: Test Suite
import "../gbm_d_85.zk"

fn test_run():
    res := gbm_drift_85(100.0, 0.1)
    diff := res - 1.3500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-gbm-drift-stage-85!")
