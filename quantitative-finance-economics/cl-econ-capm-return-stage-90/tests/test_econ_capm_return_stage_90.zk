// cl-econ-capm-return-stage-90: Test Suite
import "../capm_r_90.zk"

fn test_run():
    res := capm_return_90(0.03, 0.11)
    diff := res - 0.1420
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-capm-return-stage-90!")
