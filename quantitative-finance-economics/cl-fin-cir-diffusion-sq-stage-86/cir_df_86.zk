// cl-fin-cir-diffusion-sq-stage-86: CIR Short Rate Diffusion Squared Stage 86
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_86(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 86.0
