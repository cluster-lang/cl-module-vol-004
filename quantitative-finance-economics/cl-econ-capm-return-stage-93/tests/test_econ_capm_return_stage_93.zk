// cl-econ-capm-return-stage-93: Test Suite
import "../capm_r_93.zk"

fn test_run():
    res := capm_return_93(0.03, 0.11)
    diff := res - 0.1444
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
