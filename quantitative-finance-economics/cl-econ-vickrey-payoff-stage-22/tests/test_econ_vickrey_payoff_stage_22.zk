// cl-econ-vickrey-payoff-stage-22: Test Suite
import "../vck_po_22.zk"

fn test_run():
    res := vickrey_surplus_22(100.0, 70.0)
    diff := res - 660.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
