// cl-fin-option-gamma-stage-53: Test Suite
import "../opt_gm_53.zk"

fn test_run():
    res := option_gamma_53(100.0, 0.2)
    diff := res - 1.0600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-gamma-stage-53!")
