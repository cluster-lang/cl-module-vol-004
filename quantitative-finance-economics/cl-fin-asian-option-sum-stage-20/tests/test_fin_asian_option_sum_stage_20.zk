import "../asn_sm_20.zk"

fn test_run():
    res := asian_price_sum_20(100.0, 105.0)
    diff := res - 4100.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-asian-option-sum-stage-20!")
