import "../bdt_dc_25.zk"

fn test_run():
    res := bdt_discount_25(0.05)
    diff := res - 23.8095
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bdt-discount-stage-25!")
