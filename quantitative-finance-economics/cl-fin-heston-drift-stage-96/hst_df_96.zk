// cl-fin-heston-drift-stage-96: Heston Variance Mean-Reversion Drift Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn heston_var_drift_96(kappa: float, theta: float, v_curr: float) -> float:
    return kappa * (theta - v_curr) * 96.0
