// cl-fin-gbm-drift-stage-70: Test Suite
import "../gbm_d_70.zk"

fn test_run():
    res := gbm_drift_70(100.0, 0.1)
    diff := res - 1.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-gbm-drift-stage-70!")
