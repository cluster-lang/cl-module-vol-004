// cl-fin-heston-drift-stage-80: Heston Variance Mean-Reversion Drift Stage 80
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn heston_var_drift_80(kappa: float, theta: float, v_curr: float) -> float:
    return kappa * (theta - v_curr) * 80.0
