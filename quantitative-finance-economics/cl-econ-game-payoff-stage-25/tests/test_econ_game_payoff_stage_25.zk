import "../game_po_25.zk"

fn test_run():
    res := game_payoff_25(0.4, 10.0, 5.0)
    diff := res - 175.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
