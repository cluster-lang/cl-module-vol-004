import "../fin_dep_38.zk"

fn test_run():
    res := straight_line_depr_38(1000.0, 100.0)
    diff := res - 20.9302
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
