// cl-fin-gbm-drift-stage-22: Test Suite
import "../gbm_d_22.zk"

fn test_run():
    res := gbm_drift_22(100.0, 0.1)
    diff := res - 0.7200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-gbm-drift-stage-22!")
