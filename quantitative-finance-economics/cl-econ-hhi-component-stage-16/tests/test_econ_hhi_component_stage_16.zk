import "../hhi_c_16.zk"

fn test_run():
    res := hhi_share_sq_16(20.0)
    diff := res - 6400.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
