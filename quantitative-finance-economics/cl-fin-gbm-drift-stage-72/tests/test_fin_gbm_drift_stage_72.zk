import "../gbm_d_72.zk"

fn test_run():
    res := gbm_drift_72(100.0, 0.1)
    diff := res - 1.2200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-gbm-drift-stage-72!")
