// cl-fin-heston-drift-stage-91: Heston Variance Mean-Reversion Drift Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn heston_var_drift_91(kappa: float, theta: float, v_curr: float) -> float:
    return kappa * (theta - v_curr) * 91.0
