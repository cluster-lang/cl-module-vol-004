import "../fin_fv_36.zk"

fn test_run():
    res := future_val_stage_36(1000.0)
    diff := res - 1360.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
