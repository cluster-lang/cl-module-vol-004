// cl-fin-option-delta-stage-53: Test Suite
import "../opt_d_53.zk"

fn test_run():
    res := option_delta_53(105.0, 100.0)
    diff := res - 0.7650
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-delta-stage-53!")
