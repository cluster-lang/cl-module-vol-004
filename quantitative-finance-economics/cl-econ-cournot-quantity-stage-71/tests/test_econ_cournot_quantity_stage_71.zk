// cl-econ-cournot-quantity-stage-71: Test Suite
import "../crt_qt_71.zk"

fn test_run():
    res := cournot_best_response_71(100.0, 20.0, 20.0)
    diff := res - 2130.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-cournot-quantity-stage-71!")
