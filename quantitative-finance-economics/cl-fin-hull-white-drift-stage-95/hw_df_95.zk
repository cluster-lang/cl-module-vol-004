// cl-fin-hull-white-drift-stage-95: Hull-White Short Rate Drift Stage 95
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn hull_white_drift_95(theta_t: float, a_param: float, r_curr: float) -> float:
    return (theta_t - a_param * r_curr) * 95.0
