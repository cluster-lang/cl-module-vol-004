// cl-fin-option-gamma-stage-25: Test Suite
import "../opt_gm_25.zk"

fn test_run():
    res := option_gamma_25(100.0, 0.2)
    diff := res - 0.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-gamma-stage-25!")
