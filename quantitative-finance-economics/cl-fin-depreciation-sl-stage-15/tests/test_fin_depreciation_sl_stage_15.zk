// cl-fin-depreciation-sl-stage-15: Test Suite
import "../fin_dep_15.zk"

fn test_run():
    res := straight_line_depr_15(1000.0, 100.0)
    diff := res - 45.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-depreciation-sl-stage-15!")
