// cl-econ-cournot-quantity-stage-60: Test Suite
import "../crt_qt_60.zk"

fn test_run():
    res := cournot_best_response_60(100.0, 20.0, 20.0)
    diff := res - 1800.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-cournot-quantity-stage-60!")
