// cl-fin-option-delta-stage-60: Option Pricing Delta Linear Approximation Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn option_delta_60(s: float, k: float) -> float:
    return 0.5 + 0.1 * (s - k) * 60.0 * 0.01
