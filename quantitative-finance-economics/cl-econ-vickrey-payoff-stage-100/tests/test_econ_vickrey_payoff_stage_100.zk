// cl-econ-vickrey-payoff-stage-100: Test Suite
import "../vck_po_100.zk"

fn test_run():
    res := vickrey_surplus_100(100.0, 70.0)
    diff := res - 3000.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-vickrey-payoff-stage-100!")
