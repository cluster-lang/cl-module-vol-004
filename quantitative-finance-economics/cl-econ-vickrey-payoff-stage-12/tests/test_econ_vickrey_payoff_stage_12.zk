// cl-econ-vickrey-payoff-stage-12: Test Suite
import "../vck_po_12.zk"

fn test_run():
    res := vickrey_surplus_12(100.0, 70.0)
    diff := res - 360.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-vickrey-payoff-stage-12!")
