// cl-econ-gini-diff-stage-9: Test Suite
import "../gini_d_9.zk"

fn test_run():
    res := gini_diff_9(100.0, 40.0)
    diff := res - 540.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-gini-diff-stage-9!")
