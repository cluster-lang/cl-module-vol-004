// cl-fin-option-gamma-stage-55: Test Suite
import "../opt_gm_55.zk"

fn test_run():
    res := option_gamma_55(100.0, 0.2)
    diff := res - 1.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-gamma-stage-55!")
