// cl-fin-gbm-drift-stage-46: Test Suite
import "../gbm_d_46.zk"

fn test_run():
    res := gbm_drift_46(100.0, 0.1)
    diff := res - 0.9600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-gbm-drift-stage-46!")
