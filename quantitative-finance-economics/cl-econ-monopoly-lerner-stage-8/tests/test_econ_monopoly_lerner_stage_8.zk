// cl-econ-monopoly-lerner-stage-8: Test Suite
import "../lrn_idx_8.zk"

fn test_run():
    res := lerner_index_8(100.0, 60.0)
    diff := res - 3.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-monopoly-lerner-stage-8!")
