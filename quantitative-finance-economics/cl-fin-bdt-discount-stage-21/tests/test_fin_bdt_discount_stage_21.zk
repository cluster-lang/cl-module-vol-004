// cl-fin-bdt-discount-stage-21: Test Suite
import "../bdt_dc_21.zk"

fn test_run():
    res := bdt_discount_21(0.05)
    diff := res - 20.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bdt-discount-stage-21!")
