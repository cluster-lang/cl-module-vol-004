// cl-econ-vickrey-payoff-stage-75: Test Suite
import "../vck_po_75.zk"

fn test_run():
    res := vickrey_surplus_75(100.0, 70.0)
    diff := res - 2250.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-vickrey-payoff-stage-75!")
