// cl-econ-capm-return-stage-2: Test Suite
import "../capm_r_2.zk"

fn test_run():
    res := capm_return_2(0.03, 0.11)
    diff := res - 0.0716
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-capm-return-stage-2!")
