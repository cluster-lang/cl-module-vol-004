// cl-econ-monopoly-lerner-stage-100: Test Suite
import "../lrn_idx_100.zk"

fn test_run():
    res := lerner_index_100(100.0, 60.0)
    diff := res - 40.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-monopoly-lerner-stage-100!")
