// cl-econ-vickrey-payoff-stage-59: Test Suite
import "../vck_po_59.zk"

fn test_run():
    res := vickrey_surplus_59(100.0, 70.0)
    diff := res - 1770.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
