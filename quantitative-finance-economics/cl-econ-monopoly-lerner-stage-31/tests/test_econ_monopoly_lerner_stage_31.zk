// cl-econ-monopoly-lerner-stage-31: Test Suite
import "../lrn_idx_31.zk"

fn test_run():
    res := lerner_index_31(100.0, 60.0)
    diff := res - 12.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-monopoly-lerner-stage-31!")
