// cl-fin-ema-weight-stage-9: Test Suite
import "../fin_ema_9.zk"

fn test_run():
    res := ema_step_9(100.0, 50.0)
    diff := res - 59.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-ema-weight-stage-9!")
