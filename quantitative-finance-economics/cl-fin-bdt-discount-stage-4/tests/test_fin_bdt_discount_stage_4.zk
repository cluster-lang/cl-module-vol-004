import "../bdt_dc_4.zk"

fn test_run():
    res := bdt_discount_4(0.05)
    diff := res - 3.8095
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bdt-discount-stage-4!")
