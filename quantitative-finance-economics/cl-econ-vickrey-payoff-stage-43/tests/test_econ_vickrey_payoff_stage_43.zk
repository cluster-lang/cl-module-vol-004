// cl-econ-vickrey-payoff-stage-43: Test Suite
import "../vck_po_43.zk"

fn test_run():
    res := vickrey_surplus_43(100.0, 70.0)
    diff := res - 1290.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-vickrey-payoff-stage-43!")
