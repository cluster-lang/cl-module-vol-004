// cl-fin-option-gamma-stage-33: Test Suite
import "../opt_gm_33.zk"

fn test_run():
    res := option_gamma_33(100.0, 0.2)
    diff := res - 0.6600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-gamma-stage-33!")
