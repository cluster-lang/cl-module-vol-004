// cl-fin-heston-drift-stage-60: Heston Variance Mean-Reversion Drift Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn heston_var_drift_60(kappa: float, theta: float, v_curr: float) -> float:
    return kappa * (theta - v_curr) * 60.0
