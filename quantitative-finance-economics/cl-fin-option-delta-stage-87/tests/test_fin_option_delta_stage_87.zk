// cl-fin-option-delta-stage-87: Test Suite
import "../opt_d_87.zk"

fn test_run():
    res := option_delta_87(105.0, 100.0)
    diff := res - 0.9350
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-delta-stage-87!")
