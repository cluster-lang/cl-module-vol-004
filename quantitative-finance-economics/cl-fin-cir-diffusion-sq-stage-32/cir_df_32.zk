// cl-fin-cir-diffusion-sq-stage-32: CIR Short Rate Diffusion Squared Stage 32
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_32(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 32.0
