// cl-fin-hull-white-drift-stage-70: Hull-White Short Rate Drift Stage 70
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn hull_white_drift_70(theta_t: float, a_param: float, r_curr: float) -> float:
    return (theta_t - a_param * r_curr) * 70.0
