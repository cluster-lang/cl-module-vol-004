// cl-econ-capm-return-stage-17: Test Suite
import "../capm_r_17.zk"

fn test_run():
    res := capm_return_17(0.03, 0.11)
    diff := res - 0.0836
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
