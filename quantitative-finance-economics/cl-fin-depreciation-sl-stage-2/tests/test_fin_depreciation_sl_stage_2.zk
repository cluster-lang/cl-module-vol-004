// cl-fin-depreciation-sl-stage-2: Test Suite
import "../fin_dep_2.zk"

fn test_run():
    res := straight_line_depr_2(1000.0, 100.0)
    diff := res - 128.5714
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-depreciation-sl-stage-2!")
