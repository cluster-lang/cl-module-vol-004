import "../bdt_dc_80.zk"

fn test_run():
    res := bdt_discount_80(0.05)
    diff := res - 76.1905
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
