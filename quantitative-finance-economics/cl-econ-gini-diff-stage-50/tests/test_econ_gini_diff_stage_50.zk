// cl-econ-gini-diff-stage-50: Test Suite
import "../gini_d_50.zk"

fn test_run():
    res := gini_diff_50(100.0, 40.0)
    diff := res - 3000.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-gini-diff-stage-50!")
