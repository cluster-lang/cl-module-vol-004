// cl-fin-bond-discount-stage-32: Test Suite
import "../bnd_dc_32.zk"

fn test_run():
    res := bond_discount_32(100.0)
    diff := res - 75.7576
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bond-discount-stage-32!")
