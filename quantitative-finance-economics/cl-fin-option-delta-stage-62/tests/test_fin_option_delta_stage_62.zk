// cl-fin-option-delta-stage-62: Test Suite
import "../opt_d_62.zk"

fn test_run():
    res := option_delta_62(105.0, 100.0)
    diff := res - 0.8100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-delta-stage-62!")
