// cl-fin-cir-diffusion-sq-stage-20: Test Suite
import "../cir_df_20.zk"

fn test_run():
    res := cir_diffusion_sq_20(0.1, 0.05)
    diff := res - 0.0100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-cir-diffusion-sq-stage-20!")
