// cl-fin-option-delta-stage-91: Option Pricing Delta Linear Approximation Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn option_delta_91(s: float, k: float) -> float:
    return 0.5 + 0.1 * (s - k) * 91.0 * 0.01
