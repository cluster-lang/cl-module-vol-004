// cl-econ-capm-return-stage-52: Test Suite
import "../capm_r_52.zk"

fn test_run():
    res := capm_return_52(0.03, 0.11)
    diff := res - 0.1116
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-capm-return-stage-52!")
