// cl-fin-cir-diffusion-sq-stage-95: CIR Short Rate Diffusion Squared Stage 95
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_95(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 95.0
