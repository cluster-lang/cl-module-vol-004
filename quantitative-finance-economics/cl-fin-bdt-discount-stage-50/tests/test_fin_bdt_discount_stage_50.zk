// cl-fin-bdt-discount-stage-50: Test Suite
import "../bdt_dc_50.zk"

fn test_run():
    res := bdt_discount_50(0.05)
    diff := res - 47.6190
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bdt-discount-stage-50!")
