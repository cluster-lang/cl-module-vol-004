// cl-fin-option-delta-stage-75: Option Pricing Delta Linear Approximation Stage 75
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn option_delta_75(s: float, k: float) -> float:
    return 0.5 + 0.1 * (s - k) * 75.0 * 0.01
