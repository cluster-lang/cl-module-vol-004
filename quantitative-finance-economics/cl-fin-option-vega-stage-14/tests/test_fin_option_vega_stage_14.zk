import "../opt_vg_14.zk"

fn test_run():
    res := option_vega_14(100.0, 1.0)
    diff := res - 560.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
