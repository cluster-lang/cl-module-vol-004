// cl-fin-cir-diffusion-sq-stage-65: CIR Short Rate Diffusion Squared Stage 65
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_65(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 65.0
