// cl-fin-cir-diffusion-sq-stage-90: CIR Short Rate Diffusion Squared Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_90(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 90.0
