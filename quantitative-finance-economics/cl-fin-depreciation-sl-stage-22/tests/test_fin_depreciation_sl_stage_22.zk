// cl-fin-depreciation-sl-stage-22: Test Suite
import "../fin_dep_22.zk"

fn test_run():
    res := straight_line_depr_22(1000.0, 100.0)
    diff := res - 33.3333
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-depreciation-sl-stage-22!")
