// cl-econ-cournot-quantity-stage-100: Test Suite
import "../crt_qt_100.zk"

fn test_run():
    res := cournot_best_response_100(100.0, 20.0, 20.0)
    diff := res - 3000.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-cournot-quantity-stage-100!")
