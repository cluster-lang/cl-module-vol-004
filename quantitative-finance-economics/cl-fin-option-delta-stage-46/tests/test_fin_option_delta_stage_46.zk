// cl-fin-option-delta-stage-46: Test Suite
import "../opt_d_46.zk"

fn test_run():
    res := option_delta_46(105.0, 100.0)
    diff := res - 0.7300
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-delta-stage-46!")
