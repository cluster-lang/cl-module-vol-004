// cl-econ-deadweight-loss-stage-33: Test Suite
import "../dw_lss_33.zk"

fn test_run():
    res := deadweight_loss_33(10.0, 20.0)
    diff := res - 3300.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
