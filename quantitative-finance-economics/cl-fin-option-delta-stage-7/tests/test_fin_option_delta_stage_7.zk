// cl-fin-option-delta-stage-7: Test Suite
import "../opt_d_7.zk"

fn test_run():
    res := option_delta_7(105.0, 100.0)
    diff := res - 0.5350
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-delta-stage-7!")
