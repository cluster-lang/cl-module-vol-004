// cl-econ-deadweight-loss-stage-20: Test Suite
import "../dw_lss_20.zk"

fn test_run():
    res := deadweight_loss_20(10.0, 20.0)
    diff := res - 2000.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-deadweight-loss-stage-20!")
