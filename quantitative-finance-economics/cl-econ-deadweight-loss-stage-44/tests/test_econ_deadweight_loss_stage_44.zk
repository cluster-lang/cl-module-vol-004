// cl-econ-deadweight-loss-stage-44: Test Suite
import "../dw_lss_44.zk"

fn test_run():
    res := deadweight_loss_44(10.0, 20.0)
    diff := res - 4400.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-deadweight-loss-stage-44!")
