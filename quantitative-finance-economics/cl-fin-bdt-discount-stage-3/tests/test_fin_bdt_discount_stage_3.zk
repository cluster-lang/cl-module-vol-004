import "../bdt_dc_3.zk"

fn test_run():
    res := bdt_discount_3(0.05)
    diff := res - 2.8571
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
