// cl-fin-ema-weight-stage-22: Test Suite
import "../fin_ema_22.zk"

fn test_run():
    res := ema_step_22(100.0, 50.0)
    diff := res - 72.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-ema-weight-stage-22!")
