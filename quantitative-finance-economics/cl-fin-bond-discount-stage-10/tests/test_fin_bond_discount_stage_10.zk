// cl-fin-bond-discount-stage-10: Test Suite
import "../bnd_dc_10.zk"

fn test_run():
    res := bond_discount_10(100.0)
    diff := res - 90.9091
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bond-discount-stage-10!")
