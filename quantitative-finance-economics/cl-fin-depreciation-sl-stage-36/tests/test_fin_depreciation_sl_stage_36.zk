// cl-fin-depreciation-sl-stage-36: Test Suite
import "../fin_dep_36.zk"

fn test_run():
    res := straight_line_depr_36(1000.0, 100.0)
    diff := res - 21.9512
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-depreciation-sl-stage-36!")
