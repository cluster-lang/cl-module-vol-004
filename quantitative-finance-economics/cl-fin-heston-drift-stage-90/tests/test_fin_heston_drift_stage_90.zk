// cl-fin-heston-drift-stage-90: Test Suite
import "../hst_df_90.zk"

fn test_run():
    res := heston_var_drift_90(2.0, 0.04, 0.03)
    diff := res - 1.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-heston-drift-stage-90!")
