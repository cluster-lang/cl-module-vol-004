// cl-econ-capm-return-stage-65: Test Suite
import "../capm_r_65.zk"

fn test_run():
    res := capm_return_65(0.03, 0.11)
    diff := res - 0.1220
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-capm-return-stage-65!")
