// cl-fin-bond-convexity-stage-20: Test Suite
import "../bnd_cx_20.zk"

fn test_run():
    res := bond_convexity_term_20(2.0, 100.0)
    diff := res - 12000.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-bond-convexity-stage-20!")
