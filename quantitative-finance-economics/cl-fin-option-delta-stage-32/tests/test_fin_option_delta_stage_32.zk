// cl-fin-option-delta-stage-32: Test Suite
import "../opt_d_32.zk"

fn test_run():
    res := option_delta_32(105.0, 100.0)
    diff := res - 0.6600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-option-delta-stage-32!")
