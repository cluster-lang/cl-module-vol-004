// cl-econ-monopoly-lerner-stage-91: Monopoly Lerner Index of Market Power Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lerner_index_91(price: float, marginal_cost: float) -> float:
    if price <= 0.0001: return 0.0
    return ((price - marginal_cost) / price) * 91.0
