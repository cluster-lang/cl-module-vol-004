// cl-fin-heston-drift-stage-87: Heston Variance Mean-Reversion Drift Stage 87
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn heston_var_drift_87(kappa: float, theta: float, v_curr: float) -> float:
    return kappa * (theta - v_curr) * 87.0
