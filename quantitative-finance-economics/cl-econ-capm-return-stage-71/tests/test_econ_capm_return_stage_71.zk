// cl-econ-capm-return-stage-71: Test Suite
import "../capm_r_71.zk"

fn test_run():
    res := capm_return_71(0.03, 0.11)
    diff := res - 0.1268
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-capm-return-stage-71!")
