// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vickrey_surplus_79(valuation: float, second_bid: float) -> float:
    if valuation < second_bid: return 0.0
    return (valuation - second_bid) * 79.0
