// cl-fin-option-delta-stage-85: Option Pricing Delta Linear Approximation Stage 85
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn option_delta_85(s: float, k: float) -> float:
    return 0.5 + 0.1 * (s - k) * 85.0 * 0.01
