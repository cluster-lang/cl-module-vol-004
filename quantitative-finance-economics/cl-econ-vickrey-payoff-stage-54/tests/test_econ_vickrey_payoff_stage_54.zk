// cl-econ-vickrey-payoff-stage-54: Test Suite
import "../vck_po_54.zk"

fn test_run():
    res := vickrey_surplus_54(100.0, 70.0)
    diff := res - 1620.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
