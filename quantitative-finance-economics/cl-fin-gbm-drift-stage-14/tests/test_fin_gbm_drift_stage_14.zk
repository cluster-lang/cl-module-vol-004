// cl-fin-gbm-drift-stage-14: Test Suite
import "../gbm_d_14.zk"

fn test_run():
    res := gbm_drift_14(100.0, 0.1)
    diff := res - 0.6400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-gbm-drift-stage-14!")
