// cl-fin-cir-diffusion-sq-stage-66: CIR Short Rate Diffusion Squared Stage 66
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn cir_diffusion_sq_66(sigma: float, r_rate: float) -> float:
    return sigma * sigma * r_rate * 66.0
