// cl-fin-modified-duration-stage-75: Test Suite
import "../mod_dur_75.zk"

fn test_run():
    res := modified_duration_75(5.0)
    diff := res - 4.7170
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-modified-duration-stage-75!")
