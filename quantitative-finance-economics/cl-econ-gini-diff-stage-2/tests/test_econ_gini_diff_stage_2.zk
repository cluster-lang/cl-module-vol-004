// cl-econ-gini-diff-stage-2: Test Suite
import "../gini_d_2.zk"

fn test_run():
    res := gini_diff_2(100.0, 40.0)
    diff := res - 120.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-gini-diff-stage-2!")
