// cl-econ-gini-diff-stage-8: Test Suite
import "../gini_d_8.zk"

fn test_run():
    res := gini_diff_8(100.0, 40.0)
    diff := res - 480.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-econ-gini-diff-stage-8!")
