// cl-fin-ema-weight-stage-14: Test Suite
import "../fin_ema_14.zk"

fn test_run():
    res := ema_step_14(100.0, 50.0)
    diff := res - 64.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-ema-weight-stage-14!")
