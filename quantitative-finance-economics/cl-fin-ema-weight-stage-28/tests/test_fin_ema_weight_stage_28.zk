// cl-fin-ema-weight-stage-28: Test Suite
import "../fin_ema_28.zk"

fn test_run():
    res := ema_step_28(100.0, 50.0)
    diff := res - 78.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fin-ema-weight-stage-28!")
