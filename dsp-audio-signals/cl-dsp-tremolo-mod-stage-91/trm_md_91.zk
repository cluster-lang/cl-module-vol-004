// cl-dsp-tremolo-mod-stage-91: Tremolo Amplitude LFO Modulation Stage 91
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tremolo_mod_91(audio_in: float, lfo_val: float) -> float:
    return audio_in * (1.0 - 0.1800 * lfo_val)
