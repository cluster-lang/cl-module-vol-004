// cl-dsp-pid-output-compute: Test Suite
import "../dsp_pid.zk"

fn test_dsp_pid():
    res := pid_compute(2.0, 5.0, 1.0, 1.0, 0.5, 0.1)
    // 2.0 + 2.5 + 0.1 = 4.6
    diff := res - 4.6
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_dsp_pid passed")

fn main():
    test_dsp_pid()
    print("✓ All tests passed for cl-dsp-pid-output-compute!")
