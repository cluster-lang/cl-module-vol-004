// cl-dsp-soft-sat-rational-stage-15: Test Suite
import "../sat_rt_15.zk"

fn test_run():
    res := rational_sat_15(1.0)
    diff := res - 7.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-soft-sat-rational-stage-15!")
