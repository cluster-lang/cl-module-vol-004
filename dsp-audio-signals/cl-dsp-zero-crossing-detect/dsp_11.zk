// cl-dsp-zero-crossing-detect: DSP Zero Crossing Detector Between Samples
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn is_zero_crossing(s0: float, s1: float) -> int:
    if (s0 >= 0.0 and s1 < 0.0) or (s0 < 0.0 and s1 >= 0.0): return 1
    return 0
