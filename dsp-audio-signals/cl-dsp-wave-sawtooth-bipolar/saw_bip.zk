// cl-dsp-wave-sawtooth-bipolar: DSP Bipolar Sawtooth Wave Generator [-1, 1]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn wave_sawtooth_bipolar(phase: float) -> float:
    p := phase
    while p >= 1.0: p = p - 1.0
    while p < 0.0: p = p + 1.0
    return 2.0 * p - 1.0
