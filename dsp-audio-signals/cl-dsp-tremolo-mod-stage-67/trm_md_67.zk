// cl-dsp-tremolo-mod-stage-67: Tremolo Amplitude LFO Modulation Stage 67
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tremolo_mod_67(audio_in: float, lfo_val: float) -> float:
    return audio_in * (1.0 - 0.6600 * lfo_val)
