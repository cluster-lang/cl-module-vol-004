// cl-dsp-window-bartlett: Bartlett Triangular Window Function Evaluation
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn window_bartlett(n: int, total_n: int) -> float:
    if total_n <= 1: return 1.0
    half := float(total_n - 1) * 0.5
    diff := float(n) - half
    if diff < 0.0: diff = 0.0 - diff
    return 1.0 - diff / half
