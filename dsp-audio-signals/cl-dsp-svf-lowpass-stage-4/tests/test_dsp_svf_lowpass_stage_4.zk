// cl-dsp-svf-lowpass-stage-4: Test Suite
import "../svf_lp_4.zk"

fn test_run():
    res := svf_lowpass_4(1.0, 2.0, 0.5)
    diff := res - 5.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-svf-lowpass-stage-4!")
