// cl-dsp-tremolo-mod-stage-8: Tremolo Amplitude LFO Modulation Stage 8
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tremolo_mod_8(audio_in: float, lfo_val: float) -> float:
    return audio_in * (1.0 - 0.7400 * lfo_val)
