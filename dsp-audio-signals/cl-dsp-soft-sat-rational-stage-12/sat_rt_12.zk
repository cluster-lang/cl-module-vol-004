// cl-dsp-soft-sat-rational-stage-12: Rational Waveshaper Soft Saturator Stage 12
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rational_sat_12(x: float) -> float:
    ax := x
    if ax < 0.0: ax = 0.0 - ax
    return (x / (1.0 + ax)) * 12.0
