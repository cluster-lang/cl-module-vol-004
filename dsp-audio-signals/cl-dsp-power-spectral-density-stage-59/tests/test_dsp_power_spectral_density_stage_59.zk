// cl-dsp-power-spectral-density-stage-59: Test Suite
import "../dsp_ps_59.zk"

fn test_run():
    res := psd_bin_59(3.0, 4.0, 10.0)
    diff := res - 147.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-power-spectral-density-stage-59!")
