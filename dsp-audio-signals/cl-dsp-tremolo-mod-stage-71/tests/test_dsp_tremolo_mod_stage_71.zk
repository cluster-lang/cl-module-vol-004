// cl-dsp-tremolo-mod-stage-71: Test Suite
import "../trm_md_71.zk"

fn test_run():
    res := tremolo_mod_71(1.0, 0.5)
    diff := res - 0.9100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-71!")
