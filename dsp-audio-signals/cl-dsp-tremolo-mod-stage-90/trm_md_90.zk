// cl-dsp-tremolo-mod-stage-90: Tremolo Amplitude LFO Modulation Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tremolo_mod_90(audio_in: float, lfo_val: float) -> float:
    return audio_in * (1.0 - 0.1000 * lfo_val)
