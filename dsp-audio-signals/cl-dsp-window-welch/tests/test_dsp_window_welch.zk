// cl-dsp-window-welch: Test Suite
import "../win_welch.zk"

fn test_run():
    res := window_welch(5, 11)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-window-welch!")
