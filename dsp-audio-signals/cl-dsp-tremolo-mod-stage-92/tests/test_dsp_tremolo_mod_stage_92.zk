// cl-dsp-tremolo-mod-stage-92: Test Suite
import "../trm_md_92.zk"

fn test_run():
    res := tremolo_mod_92(1.0, 0.5)
    diff := res - 0.8700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
