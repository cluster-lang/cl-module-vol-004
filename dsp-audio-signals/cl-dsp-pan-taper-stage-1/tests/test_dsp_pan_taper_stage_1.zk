// cl-dsp-pan-taper-stage-1: Test Suite
import "../pan_st_1.zk"

fn test_run():
    res := pan_taper_1(0.0)
    diff := res - 0.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-pan-taper-stage-1!")
