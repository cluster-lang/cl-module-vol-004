// cl-dsp-tremolo-mod-stage-75: Test Suite
import "../trm_md_75.zk"

fn test_run():
    res := tremolo_mod_75(1.0, 0.5)
    diff := res - 0.7500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-75!")
