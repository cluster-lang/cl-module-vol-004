// cl-dsp-sinc-tap-stage-26: Test Suite
import "../sinc_st_26.zk"

fn test_run():
    res := sinc_tap_26(0.0)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-sinc-tap-stage-26!")
