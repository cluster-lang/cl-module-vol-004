// cl-dsp-tremolo-mod-stage-42: Test Suite
import "../trm_md_42.zk"

fn test_run():
    res := tremolo_mod_42(1.0, 0.5)
    diff := res - 0.8700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-42!")
