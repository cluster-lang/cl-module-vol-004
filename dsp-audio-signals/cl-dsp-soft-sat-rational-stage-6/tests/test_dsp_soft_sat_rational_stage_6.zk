// cl-dsp-soft-sat-rational-stage-6: Test Suite
import "../sat_rt_6.zk"

fn test_run():
    res := rational_sat_6(1.0)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-soft-sat-rational-stage-6!")
