// cl-dsp-soft-sat-rational-stage-75: Test Suite
import "../sat_rt_75.zk"

fn test_run():
    res := rational_sat_75(1.0)
    diff := res - 37.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-soft-sat-rational-stage-75!")
