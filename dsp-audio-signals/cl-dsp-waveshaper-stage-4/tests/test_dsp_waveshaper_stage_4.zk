// cl-dsp-waveshaper-stage-4: Test Suite
import "../ws_st_4.zk"

fn test_run():
    res := waveshaper_stage_4(0.0)
    diff := res - 0.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-waveshaper-stage-4!")
