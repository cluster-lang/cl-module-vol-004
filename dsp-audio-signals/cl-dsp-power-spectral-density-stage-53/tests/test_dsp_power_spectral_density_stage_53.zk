// cl-dsp-power-spectral-density-stage-53: Test Suite
import "../dsp_ps_53.zk"

fn test_run():
    res := psd_bin_53(3.0, 4.0, 10.0)
    diff := res - 132.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-power-spectral-density-stage-53!")
