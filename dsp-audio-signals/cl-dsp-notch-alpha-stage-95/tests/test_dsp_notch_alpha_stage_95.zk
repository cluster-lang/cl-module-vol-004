// cl-dsp-notch-alpha-stage-95: Test Suite
import "../ntc_a_95.zk"

fn test_run():
    res := notch_alpha_95(1.0)
    diff := res - 0.0952
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-notch-alpha-stage-95!")
