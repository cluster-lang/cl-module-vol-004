// cl-dsp-wave-triangle-bipolar: Test Suite
import "../tri_bip.zk"

fn test_tri():
    if wave_triangle_bipolar(0.0) != 0.0: sys_exit(1)
    if wave_triangle_bipolar(0.25) != 1.0: sys_exit(1)
    if wave_triangle_bipolar(0.5) != 0.0: sys_exit(1)
    if wave_triangle_bipolar(0.75) != (0.0 - 1.0): sys_exit(1)
    print("test_tri passed")

fn main():
    test_tri()
    print("✓ All tests passed for cl-dsp-wave-triangle-bipolar!")
