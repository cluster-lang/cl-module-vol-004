// cl-dsp-wave-triangle-bipolar: DSP Bipolar Triangle Wave Generator [-1, 1]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn wave_triangle_bipolar(phase: float) -> float:
    p := phase
    while p >= 1.0: p = p - 1.0
    while p < 0.0: p = p + 1.0
    if p < 0.25: return 4.0 * p
    if p < 0.75: return 2.0 - 4.0 * p
    return 4.0 * p - 4.0
