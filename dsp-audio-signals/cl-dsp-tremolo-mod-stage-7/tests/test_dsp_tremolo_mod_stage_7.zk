// cl-dsp-tremolo-mod-stage-7: Test Suite
import "../trm_md_7.zk"

fn test_run():
    res := tremolo_mod_7(1.0, 0.5)
    diff := res - 0.6700
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-7!")
