import "../rm_pd_21.zk"

fn test_run():
    res := ring_mod_prod_21(0.8, 0.5)
    diff := res - 8.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
