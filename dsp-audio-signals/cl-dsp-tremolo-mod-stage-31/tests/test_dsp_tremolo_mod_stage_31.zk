// cl-dsp-tremolo-mod-stage-31: Test Suite
import "../trm_md_31.zk"

fn test_run():
    res := tremolo_mod_31(1.0, 0.5)
    diff := res - 0.9100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-31!")
