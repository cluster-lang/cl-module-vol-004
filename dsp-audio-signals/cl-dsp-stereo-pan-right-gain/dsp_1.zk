// cl-dsp-stereo-pan-right-gain: Stereo Linear Panning Right Channel Gain
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn stereo_pan_right_gain(pan: float) -> float:
    p := pan
    if p < -1.0: p = -1.0
    if p > 1.0: p = 1.0
    return 0.5 * (1.0 + p)
