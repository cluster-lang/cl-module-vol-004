// cl-dsp-stereo-pan-right-gain: Test Suite
import "../dsp_1.zk"

fn test_1():
    res := stereo_pan_right_gain(0.0)
    diff := res - 0.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_1()
    print("✓ All tests passed for cl-dsp-stereo-pan-right-gain!")
