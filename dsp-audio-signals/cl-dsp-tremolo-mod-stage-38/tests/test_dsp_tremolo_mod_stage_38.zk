// cl-dsp-tremolo-mod-stage-38: Test Suite
import "../trm_md_38.zk"

fn test_run():
    res := tremolo_mod_38(1.0, 0.5)
    diff := res - 0.6300
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-38!")
