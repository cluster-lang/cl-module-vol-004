// cl-dsp-slew-rate-step: Linear Slew Rate Limiter Step
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn dsp_slew_rate(current: float, target: float, max_rate: float) -> float:
    delta := target - current
    if delta > max_rate:
        return current + max_rate
    if delta < (0.0 - max_rate):
        return current - max_rate
    return target
