// cl-dsp-vibrato-phase-inc: Test Suite
import "../dsp_vibr.zk"

fn test_run():
    res := dsp_vibrato_inc(440.0, 0.0, 1.0, 44100.0)
    diff := res - 0.0100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-vibrato-phase-inc!")
