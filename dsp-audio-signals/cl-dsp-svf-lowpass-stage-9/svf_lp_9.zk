// cl-dsp-svf-lowpass-stage-9: State Variable Filter Lowpass Pole Stage 9
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn svf_lowpass_9(low: float, band: float, f_coeff: float) -> float:
    return low + f_coeff * band * 9.0
