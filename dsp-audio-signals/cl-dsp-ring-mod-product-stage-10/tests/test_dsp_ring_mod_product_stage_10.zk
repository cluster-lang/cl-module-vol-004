// cl-dsp-ring-mod-product-stage-10: Test Suite
import "../rm_pd_10.zk"

fn test_run():
    res := ring_mod_prod_10(0.8, 0.5)
    diff := res - 4.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-ring-mod-product-stage-10!")
