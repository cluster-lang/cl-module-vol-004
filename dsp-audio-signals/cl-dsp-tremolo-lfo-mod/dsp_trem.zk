// cl-dsp-tremolo-lfo-mod: Tremolo Amplitude Modulation by LFO
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn dsp_tremolo_mod(sample: float, lfo: float, depth: float) -> float:
    // lfo in [0, 1]
    gain := 1.0 - depth * (1.0 - lfo)
    return sample * gain
