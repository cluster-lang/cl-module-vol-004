// cl-dsp-window-cosine: Cosine (Half-Sine) Window Function
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn window_cosine_parabolic(n: int, total_n: int) -> float:
    if total_n <= 1: return 1.0
    x := float(n) / float(total_n - 1)
    return 1.0 - 4.0 * (x - 0.5) * (x - 0.5)
