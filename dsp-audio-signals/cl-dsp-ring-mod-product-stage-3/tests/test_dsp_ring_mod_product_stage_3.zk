// cl-dsp-ring-mod-product-stage-3: Test Suite
import "../rm_pd_3.zk"

fn test_run():
    res := ring_mod_prod_3(0.8, 0.5)
    diff := res - 1.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-ring-mod-product-stage-3!")
