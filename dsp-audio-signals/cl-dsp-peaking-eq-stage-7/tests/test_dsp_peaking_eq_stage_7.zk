// cl-dsp-peaking-eq-stage-7: Test Suite
import "../peak_eq_7.zk"

fn test_run():
    res := peaking_eq_gain_7(2.0)
    diff := res - 2.7000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-peaking-eq-stage-7!")
