// cl-dsp-sinc-tap-stage-38: Test Suite
import "../sinc_st_38.zk"

fn test_run():
    res := sinc_tap_38(0.0)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-sinc-tap-stage-38!")
