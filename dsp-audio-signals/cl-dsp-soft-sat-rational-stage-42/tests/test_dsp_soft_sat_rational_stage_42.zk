import "../sat_rt_42.zk"

fn test_run():
    res := rational_sat_42(1.0)
    diff := res - 21.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
