// cl-dsp-tremolo-mod-stage-36: Test Suite
import "../trm_md_36.zk"

fn test_run():
    res := tremolo_mod_36(1.0, 0.5)
    diff := res - 0.7100
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-dsp-tremolo-mod-stage-36!")
