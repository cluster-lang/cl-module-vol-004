// cl-dsp-pitch-semitones-to-ratio: Test Suite
import "../dsp_2.zk"

fn test_2():
    res := semitones_to_ratio(0.0)
    diff := res - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_2()
    print("✓ All tests passed for cl-dsp-pitch-semitones-to-ratio!")
