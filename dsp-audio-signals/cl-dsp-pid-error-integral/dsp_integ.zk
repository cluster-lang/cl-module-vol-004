// cl-dsp-pid-error-integral: Trapezoidal PID Integral Accumulator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn pid_update_integral(integral_prev: float, err: float, dt: float) -> float:
    return integral_prev + err * dt
