// cl-dsp-pid-error-integral: Test Suite
import "../dsp_integ.zk"

fn test_dsp_integ():
    res := pid_update_integral(5.0, 2.0, 0.5)
    // 5.0 + 2.0 * 0.5 = 6.0
    diff := res - 6.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_dsp_integ passed")

fn main():
    test_dsp_integ()
    print("✓ All tests passed for cl-dsp-pid-error-integral!")
