// cl-fea-beam-bending-moment-stage-17: Euler-Bernoulli Elastic Beam Bending Moment Stage 17
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn beam_moment_17(e: float, i_inertia: float, curvature: float) -> float:
    return (e * i_inertia * curvature) * 17.0
