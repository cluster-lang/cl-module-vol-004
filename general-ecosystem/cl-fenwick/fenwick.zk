fn fenwick_new(size: int) -> vector[int]:
    tree: vector[int] := []
    i := 0
    while i <= size:
        tree.push(0)
        i = i + 1
    return tree

fn fenwick_add(tree: vector[int], idx: int, delta: int):
    tlen := tree.len()
    i := idx
    while i < tlen:
        tree[i] = tree[i] + delta
        i = i + (i & (0 - i))

fn fenwick_query(tree: vector[int], idx: int) -> int:
    sum := 0
    i := idx
    while i > 0:
        sum = sum + tree[i]
        i = i - (i & (0 - i))
    return sum

fn fenwick_range_query(tree: vector[int], left: int, right: int) -> int:
    return fenwick_query(tree, right) - fenwick_query(tree, left - 1)
