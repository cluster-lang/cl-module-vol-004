// cl-fea-torsional-rigidity-stage-88: Shaft Circular Torsional Rigidity Constant Stage 88
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_88(g: float, j: float, l: float) -> float:
    return (g * j / l) * 88.0
