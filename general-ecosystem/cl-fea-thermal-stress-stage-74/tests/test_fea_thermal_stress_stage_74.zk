// cl-fea-thermal-stress-stage-74: Test Suite
import "../fe_ts_74.zk"

fn test_run():
    res := thermal_stress_74(200.0, 0.000012, 50.0)
    diff := res - 8.8800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fea-thermal-stress-stage-74!")
