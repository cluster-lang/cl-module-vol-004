// cl-fea-beam-bending-moment-stage-31: Euler-Bernoulli Elastic Beam Bending Moment Stage 31
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn beam_moment_31(e: float, i_inertia: float, curvature: float) -> float:
    return (e * i_inertia * curvature) * 31.0
