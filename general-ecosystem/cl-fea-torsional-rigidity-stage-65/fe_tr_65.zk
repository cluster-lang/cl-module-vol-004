// cl-fea-torsional-rigidity-stage-65: Shaft Circular Torsional Rigidity Constant Stage 65
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_65(g: float, j: float, l: float) -> float:
    return (g * j / l) * 65.0
