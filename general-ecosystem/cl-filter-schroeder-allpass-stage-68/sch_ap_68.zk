// cl-filter-schroeder-allpass-stage-68: Schroeder All-Pass Reverb Stage 68
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn schroeder_allpass_68(input_val: float, delayed_val: float, g: float) -> float:
    return (0.0 - g * input_val + delayed_val) * 68.0
