// cl-ease-repeat-sawtooth: Test Suite
import "../e_saw.zk"

fn test_e_saw():
    res := ease_sawtooth(3.25)
    diff := res - 0.25
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_saw passed")

fn main():
    test_e_saw()
    print("✓ All tests passed for cl-ease-repeat-sawtooth!")
