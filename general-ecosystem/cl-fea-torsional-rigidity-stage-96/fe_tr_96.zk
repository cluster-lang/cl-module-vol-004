// cl-fea-torsional-rigidity-stage-96: Shaft Circular Torsional Rigidity Constant Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_96(g: float, j: float, l: float) -> float:
    return (g * j / l) * 96.0
