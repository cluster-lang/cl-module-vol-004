// cl-euler-rot-matrix-r23: Euler ZYX Matrix Element R23 (sinY*sinP*cosR - cosY*sinR)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn euler_r23(cy: float, sy: float, cp: float, sp: float, cr: float, sr: float) -> float:
    return sy * sp * cr - cy * sr
