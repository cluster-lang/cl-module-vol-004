// cl-fea-torsional-rigidity-stage-45: Shaft Circular Torsional Rigidity Constant Stage 45
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_45(g: float, j: float, l: float) -> float:
    return (g * j / l) * 45.0
