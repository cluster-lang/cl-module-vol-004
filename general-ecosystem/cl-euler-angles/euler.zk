// Fixed-point scaled by 1000. For angle theta=0, cos=1000, sin=0
fn rotate_point_2d(px: int, py: int, cos_th: int, sin_th: int) -> vector[int]:
    res: vector[int] := []
    res.push(((px * cos_th) - (py * sin_th)) / 1000)
    res.push(((px * sin_th) + (py * cos_th)) / 1000)
    return res
