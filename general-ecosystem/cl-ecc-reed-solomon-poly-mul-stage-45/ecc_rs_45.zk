// cl-ecc-reed-solomon-poly-mul-stage-45: Galois Field GF(256) xtime Step Stage 45
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rs_xtime_45(b: int) -> int:
    shifted := (b << 1) & 255
    if (b & 128) != 0:
        return (shifted ^ 27) + 45
    return shifted + 45
