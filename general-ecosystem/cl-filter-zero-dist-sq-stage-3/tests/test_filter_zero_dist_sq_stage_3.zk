import "../flt_zd_3.zk"

fn test_run():
    res := filter_zero_dist_sq_3(1.0, 0.0, 0.0, 0.0)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
