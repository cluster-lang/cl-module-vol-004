// cl-fea-torsional-rigidity-stage-35: Test Suite
import "../fe_tr_35.zk"

fn test_run():
    res := torsion_rigidity_35(80.0, 0.002, 1.0)
    diff := res - 5.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fea-torsional-rigidity-stage-35!")
