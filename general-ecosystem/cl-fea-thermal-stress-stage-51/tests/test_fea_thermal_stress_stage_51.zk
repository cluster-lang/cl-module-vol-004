// cl-fea-thermal-stress-stage-51: Test Suite
import "../fe_ts_51.zk"

fn test_run():
    res := thermal_stress_51(200.0, 0.000012, 50.0)
    diff := res - 6.1200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fea-thermal-stress-stage-51!")
