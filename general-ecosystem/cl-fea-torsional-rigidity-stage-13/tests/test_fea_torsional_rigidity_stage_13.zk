// cl-fea-torsional-rigidity-stage-13: Test Suite
import "../fe_tr_13.zk"

fn test_run():
    res := torsion_rigidity_13(80.0, 0.002, 1.0)
    diff := res - 2.0800
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
