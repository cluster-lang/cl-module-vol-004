// cl-fea-truss-stiffness-k-stage-19: Test Suite
import "../fe_tk_19.zk"

fn test_run():
    res := truss_k_19(200.0, 0.05, 2.0)
    diff := res - 95.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fea-truss-stiffness-k-stage-19!")
