// cl-ease-out-quart: Test Suite
import "../e_out_q4.zk"

fn test_e_out_q4():
    res := ease_out_quart(0.5)
    diff := res - 0.9375
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_out_q4 passed")

fn main():
    test_e_out_q4()
    print("✓ All tests passed for cl-ease-out-quart!")
