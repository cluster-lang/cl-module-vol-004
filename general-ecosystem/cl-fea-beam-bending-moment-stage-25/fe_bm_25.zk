// cl-fea-beam-bending-moment-stage-25: Euler-Bernoulli Elastic Beam Bending Moment Stage 25
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn beam_moment_25(e: float, i_inertia: float, curvature: float) -> float:
    return (e * i_inertia * curvature) * 25.0
