// cl-euler-rot-matrix-r12: Euler ZYX Matrix Element R12 (cosY*sinP*sinR - sinY*cosR)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn euler_r12(cy: float, sy: float, cp: float, sp: float, cr: float, sr: float) -> float:
    return cy * sp * sr - sy * cr
