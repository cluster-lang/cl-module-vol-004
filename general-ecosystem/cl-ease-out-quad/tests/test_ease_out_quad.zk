// cl-ease-out-quad: Test Suite
import "../e_out_q.zk"

fn test_e_out_q():
    res := ease_out_quad(0.5)
    diff := res - 0.75
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_out_q passed")

fn main():
    test_e_out_q()
    print("✓ All tests passed for cl-ease-out-quad!")
