// cl-ellipsoid: 3D Ellipsoid Point Containment Query
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ellipsoid_contains(cx: int, cy: int, cz: int, rx: int, ry: int, rz: int, px: int, py: int, pz: int) -> int:
    dx := px - cx
    dy := py - cy
    dz := pz - cz

    // (dx/rx)^2 + (dy/ry)^2 + (dz/rz)^2 <= 1
    // Multiply by (rx*ry*rz)^2 to keep pure integer arithmetic
    term_x := dx * dx * ry * ry * rz * rz
    term_y := dy * dy * rx * rx * rz * rz
    term_z := dz * dz * rx * rx * ry * ry
    bound := rx * rx * ry * ry * rz * rz

    if (term_x + term_y + term_z) <= bound: return 1
    return 0
