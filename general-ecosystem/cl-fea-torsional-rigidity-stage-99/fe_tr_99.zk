// cl-fea-torsional-rigidity-stage-99: Shaft Circular Torsional Rigidity Constant Stage 99
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_99(g: float, j: float, l: float) -> float:
    return (g * j / l) * 99.0
