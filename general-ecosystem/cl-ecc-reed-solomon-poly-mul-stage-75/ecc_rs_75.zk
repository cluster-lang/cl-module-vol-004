// cl-ecc-reed-solomon-poly-mul-stage-75: Galois Field GF(256) xtime Step Stage 75
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rs_xtime_75(b: int) -> int:
    shifted := (b << 1) & 255
    if (b & 128) != 0:
        return (shifted ^ 27) + 75
    return shifted + 75
