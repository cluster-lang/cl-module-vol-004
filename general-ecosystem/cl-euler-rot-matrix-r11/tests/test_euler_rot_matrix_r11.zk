// cl-euler-rot-matrix-r11: Test Suite
import "../e_r11.zk"

fn test_run():
    res := euler_r11(1.0, 1.0)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-euler-rot-matrix-r11!")
