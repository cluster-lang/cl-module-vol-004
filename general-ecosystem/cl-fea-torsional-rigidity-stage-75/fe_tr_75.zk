// cl-fea-torsional-rigidity-stage-75: Shaft Circular Torsional Rigidity Constant Stage 75
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_75(g: float, j: float, l: float) -> float:
    return (g * j / l) * 75.0
