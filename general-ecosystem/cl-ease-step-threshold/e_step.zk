// cl-ease-step-threshold: Binary Step Function at Edge Threshold
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ease_step(edge: float, x: float) -> float:
    if x < edge:
        return 0.0
    return 1.0
