// cl-fea-thermal-stress-stage-100: Constrained Thermal Expansion Normal Stress Stage 100
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn thermal_stress_100(e: float, alpha: float, delta_t: float) -> float:
    return (e * alpha * delta_t) * 100.0
