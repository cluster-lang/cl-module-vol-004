// cl-ease-in-cubic: Test Suite
import "../e_in_c.zk"

fn test_e_in_c():
    res := ease_in_cubic(0.5)
    diff := res - 0.125
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_in_c passed")

fn main():
    test_e_in_c()
    print("✓ All tests passed for cl-ease-in-cubic!")
