// cl-fea-torsional-rigidity-stage-60: Shaft Circular Torsional Rigidity Constant Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn torsion_rigidity_60(g: float, j: float, l: float) -> float:
    return (g * j / l) * 60.0
