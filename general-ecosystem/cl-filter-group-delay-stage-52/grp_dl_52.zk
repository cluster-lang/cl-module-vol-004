// cl-filter-group-delay-stage-52: Discrete Filter Group Delay Approximation Stage 52
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn group_delay_approx_52(d_phase: float, d_omega: float) -> float:
    if d_omega <= 0.0001: return 0.0
    return (0.0 - (d_phase / d_omega)) * 52.0
