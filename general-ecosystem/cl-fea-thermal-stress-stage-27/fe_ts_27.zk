// cl-fea-thermal-stress-stage-27: Constrained Thermal Expansion Normal Stress Stage 27
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn thermal_stress_27(e: float, alpha: float, delta_t: float) -> float:
    return (e * alpha * delta_t) * 27.0
