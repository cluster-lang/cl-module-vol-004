// cl-filter-schroeder-allpass-stage-45: Test Suite
import "../sch_ap_45.zk"

fn test_run():
    res := schroeder_allpass_45(2.0, 5.0, 0.5)
    diff := res - 180.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-filter-schroeder-allpass-stage-45!")
