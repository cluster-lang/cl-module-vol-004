// cl-ecc-reed-solomon-poly-mul-stage-83: Galois Field GF(256) xtime Step Stage 83
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rs_xtime_83(b: int) -> int:
    shifted := (b << 1) & 255
    if (b & 128) != 0:
        return (shifted ^ 27) + 83
    return shifted + 83
