// cl-euler-rot-matrix-r13: Euler ZYX Matrix Element R13 (cosY*sinP*cosR + sinY*sinR)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn euler_r13(cy: float, sy: float, cp: float, sp: float, cr: float, sr: float) -> float:
    return cy * sp * cr + sy * sr
