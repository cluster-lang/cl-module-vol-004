// cl-ease-inout-quint: Piecewise Quintic In-Out S-curve
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ease_inout_quint(t: float) -> float:
    if t < 0.5:
        return 16.0 * t * t * t * t * t
    tm := 2.0 * t - 2.0
    return 0.5 * tm * tm * tm * tm * tm + 1.0
