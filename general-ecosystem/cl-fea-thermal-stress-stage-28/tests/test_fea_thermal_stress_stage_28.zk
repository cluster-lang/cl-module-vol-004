// cl-fea-thermal-stress-stage-28: Test Suite
import "../fe_ts_28.zk"

fn test_run():
    res := thermal_stress_28(200.0, 0.000012, 50.0)
    diff := res - 3.3600
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fea-thermal-stress-stage-28!")
