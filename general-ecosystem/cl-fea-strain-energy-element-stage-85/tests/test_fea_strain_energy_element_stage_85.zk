// cl-fea-strain-energy-element-stage-85: Test Suite
import "../fe_se_85.zk"

fn test_run():
    res := strain_energy_85(1000.0, 0.1)
    diff := res - 425.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-fea-strain-energy-element-stage-85!")
