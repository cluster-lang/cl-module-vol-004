// cl-ease-in-quad: Test Suite
import "../e_in_q.zk"

fn test_e_in_q():
    res := ease_in_quad(0.5)
    diff := res - 0.25
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_in_q passed")

fn main():
    test_e_in_q()
    print("✓ All tests passed for cl-ease-in-quad!")
