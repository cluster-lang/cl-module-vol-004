// cl-euler-rot-matrix-r31: Test Suite
import "../e_r31.zk"

fn test_run():
    res := euler_r31(0.0)
    diff := res - 0.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-euler-rot-matrix-r31!")
