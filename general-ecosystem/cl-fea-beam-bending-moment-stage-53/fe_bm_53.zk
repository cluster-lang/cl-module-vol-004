// cl-fea-beam-bending-moment-stage-53: Euler-Bernoulli Elastic Beam Bending Moment Stage 53
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn beam_moment_53(e: float, i_inertia: float, curvature: float) -> float:
    return (e * i_inertia * curvature) * 53.0
