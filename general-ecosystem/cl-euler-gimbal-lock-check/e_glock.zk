// cl-euler-gimbal-lock-check: Check for Pitch Gimbal Lock (|sinP| >= 1.0 - eps)
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn is_gimbal_lock(sp: float, eps: float) -> int:
    val := sp
    if val < 0.0: val = 0.0 - val
    if val >= (1.0 - eps): return 1
    return 0
