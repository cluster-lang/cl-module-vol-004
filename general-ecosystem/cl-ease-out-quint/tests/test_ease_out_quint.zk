// cl-ease-out-quint: Test Suite
import "../e_out_q5.zk"

fn test_e_out_q5():
    res := ease_out_quint(0.5)
    diff := res - 0.96875
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_out_q5 passed")

fn main():
    test_e_out_q5()
    print("✓ All tests passed for cl-ease-out-quint!")
