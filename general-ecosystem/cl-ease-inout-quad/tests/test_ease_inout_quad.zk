// cl-ease-inout-quad: Test Suite
import "../e_io_q.zk"

fn test_e_io_q():
    res := ease_inout_quad(0.5)
    diff := res - 0.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_io_q passed")

fn main():
    test_e_io_q()
    print("✓ All tests passed for cl-ease-inout-quad!")
