// cl-ease-inout-quart: Test Suite
import "../e_io_q4.zk"

fn test_e_io_q4():
    res := ease_inout_quart(0.5)
    diff := res - 0.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_io_q4 passed")

fn main():
    test_e_io_q4()
    print("✓ All tests passed for cl-ease-inout-quart!")
