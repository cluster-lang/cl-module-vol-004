// cl-ease-smoothstep-3: Test Suite
import "../e_ss3.zk"

fn test_e_ss3():
    res := ease_smoothstep(0.5)
    diff := res - 0.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_ss3 passed")

fn main():
    test_e_ss3()
    print("✓ All tests passed for cl-ease-smoothstep-3!")
