// cl-ease-in-quart: Test Suite
import "../e_in_q4.zk"

fn test_e_in_q4():
    res := ease_in_quart(0.5)
    diff := res - 0.0625
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_e_in_q4 passed")

fn main():
    test_e_in_q4()
    print("✓ All tests passed for cl-ease-in-quart!")
